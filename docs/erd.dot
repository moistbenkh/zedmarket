digraph ERD {
rankdir=LR; nodesep=0.5; ranksep=1.2; fontname="Helvetica"; bgcolor="white";
node [shape=plain fontname="Helvetica" fontsize=10];
edge [color="#4a5568" arrowhead=crow arrowtail=tee dir=both fontsize=8];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><B>PK</B></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">&nbsp;</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="parent_category_id"><B>FK</B></TD><TD ALIGN="LEFT">parent_category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><B>PK</B></TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><B>FK</B></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">&nbsp;</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sku">&nbsp;</TD><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price">&nbsp;</TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_quantity">&nbsp;</TD><TD ALIGN="LEFT">stock_quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reorder_level">&nbsp;</TD><TD ALIGN="LEFT">reorder_level</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">&nbsp;</TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DATETIME</FONT></TD></TR></TABLE>>];
customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2f855a"><TR><TD COLSPAN="3" BGCOLOR="#2f855a"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><B>PK</B></TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name">&nbsp;</TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name">&nbsp;</TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">&nbsp;</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">&nbsp;</TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">&nbsp;</TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role">&nbsp;</TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registered_at">&nbsp;</TD><TD ALIGN="LEFT">registered_at</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DATETIME</FONT></TD></TR></TABLE>>];
addresses [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2f855a"><TR><TD COLSPAN="3" BGCOLOR="#2f855a"><FONT COLOR="white"><B>addresses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="address_id"><B>PK</B></TD><TD ALIGN="LEFT">address_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><B>FK</B></TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="street">&nbsp;</TD><TD ALIGN="LEFT">street</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city">&nbsp;</TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="province">&nbsp;</TD><TD ALIGN="LEFT">province</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="country">&nbsp;</TD><TD ALIGN="LEFT">country</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_default">&nbsp;</TD><TD ALIGN="LEFT">is_default</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">BOOLEAN</FONT></TD></TR></TABLE>>];
orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c05621"><TR><TD COLSPAN="3" BGCOLOR="#c05621"><FONT COLOR="white"><B>orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><B>PK</B></TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><B>FK</B></TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="address_id"><B>FK</B></TD><TD ALIGN="LEFT">address_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_date">&nbsp;</TD><TD ALIGN="LEFT">order_date</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">&nbsp;</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount">&nbsp;</TD><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c05621"><TR><TD COLSPAN="3" BGCOLOR="#c05621"><FONT COLOR="white"><B>order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_item_id"><B>PK</B></TD><TD ALIGN="LEFT">order_item_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><B>FK</B></TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><B>FK</B></TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">&nbsp;</TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">&nbsp;</TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#c05621"><TR><TD COLSPAN="3" BGCOLOR="#c05621"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_id"><B>PK</B></TD><TD ALIGN="LEFT">payment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><B>FK</B></TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="method">&nbsp;</TD><TD ALIGN="LEFT">method</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">&nbsp;</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount">&nbsp;</TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="paid_at">&nbsp;</TD><TD ALIGN="LEFT">paid_at</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DATETIME</FONT></TD></TR></TABLE>>];
reviews [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6b46c1"><TR><TD COLSPAN="3" BGCOLOR="#6b46c1"><FONT COLOR="white"><B>reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="review_id"><B>PK</B></TD><TD ALIGN="LEFT">review_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><B>FK</B></TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><B>FK</B></TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rating">&nbsp;</TD><TD ALIGN="LEFT">rating</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="comment">&nbsp;</TD><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DATETIME</FONT></TD></TR></TABLE>>];
audit_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#718096"><TR><TD COLSPAN="3" BGCOLOR="#718096"><FONT COLOR="white"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="audit_id"><B>PK</B></TD><TD ALIGN="LEFT">audit_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="table_name">&nbsp;</TD><TD ALIGN="LEFT">table_name</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="record_id">&nbsp;</TD><TD ALIGN="LEFT">record_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="action">&nbsp;</TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="old_value">&nbsp;</TD><TD ALIGN="LEFT">old_value</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="new_value">&nbsp;</TD><TD ALIGN="LEFT">new_value</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="changed_by">&nbsp;</TD><TD ALIGN="LEFT">changed_by</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="changed_at">&nbsp;</TD><TD ALIGN="LEFT">changed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#718096">DATETIME</FONT></TD></TR></TABLE>>];
categories -> categories [label="parent_category_id"];
categories -> products [label="category_id"];
customers -> addresses [label="customer_id"];
customers -> orders [label="customer_id"];
addresses -> orders [label="address_id"];
orders -> order_items [label="order_id"];
products -> order_items [label="product_id"];
orders -> payments [label="order_id"];
products -> reviews [label="product_id"];
customers -> reviews [label="customer_id"];
}